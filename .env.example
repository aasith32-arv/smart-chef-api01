# Flask
SECRET_KEY=your-secret-key
FLASK_DEBUG=True
LOG_LEVEL=INFO

# JWT
JWT_SECRET_KEY=change-this-to-a-unique-32-character-minimum-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=true
# JWT_COOKIE_DOMAIN=
# Vercel proxy deployment: use Secure=true, SameSite=Lax, and leave domain unset.

# Database
USE_MYSQL=false
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aichef_db
# DATABASE_URL=sqlite:///instance/aichef.db

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# CORS (never use *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATELIMIT_STORAGE_URI=memory://

# AI provider (optional): auto, openai, or gemini
AI_PROVIDER=auto

# OpenAI
# OPENAI_API_KEY=sk-your-real-key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
# GEMINI_API_KEY=your-real-key
GEMINI_MODEL=gemini-flash-latest

# Stripe Checkout (secret and webhook keys must only be configured on the API)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional reusable Dashboard Price IDs; trusted inline LKR prices are used when blank.
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_ADVERTISING_PRICE_ID=
FRONTEND_URL=http://localhost:3000

# Observability (optional — leave blank to disable)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0
